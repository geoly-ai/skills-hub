{
  "schema_version": "1",
  "id": "test-plan",
  "name": "测试计划",
  "version": "1.0.0",
  "status": "draft",
  "description": "测试计划类型包",
  "audience": "internal",
  "brand_profile": "internal",
  "run_root": "~/workspace/docs/{project}",
  "run_dir_pattern": "{type}-{short}-v{version}",
  "source_file": "doc.md",
  "outline_file": "outline.md",
  "meta_file": "doc.json",
  "inputs": [
    {
      "id": "input1",
      "desc": "被测版本与关联 PRD / Spec",
      "required": true
    },
    {
      "id": "input2",
      "desc": "被测需求清单（关联 PRD 的 REQ 编号，或其 data/requirements.csv）",
      "required": true
    }
  ],
  "skeleton": [
    {
      "id": "scope",
      "title": "测试范围与不测范围",
      "level": 1,
      "required": true,
      "must_answer": [
        "功能",
        "平台",
        "版本",
        "不测理由"
      ]
    },
    {
      "id": "strategy",
      "title": "测试策略",
      "level": 1,
      "required": true,
      "must_answer": [
        "类型（功能",
        "接口",
        "兼容",
        "性能",
        "安全",
        "回归）",
        "方法",
        "自动化比例"
      ]
    },
    {
      "id": "environment",
      "title": "环境与数据",
      "level": 1,
      "required": true,
      "must_answer": [
        "环境清单",
        "测试账号",
        "数据准备"
      ]
    },
    {
      "id": "entry-exit",
      "title": "准入与准出标准",
      "level": 1,
      "required": true,
      "must_answer": [
        "可量化（缺陷级别与数量",
        "用例通过率）"
      ]
    },
    {
      "id": "schedule",
      "title": "进度与人员",
      "level": 1,
      "required": true,
      "must_answer": [
        "阶段",
        "负责人"
      ]
    },
    {
      "id": "risks",
      "title": "风险与应对",
      "level": 1,
      "required": true
    },
    {
      "id": "defect-mgmt",
      "title": "缺陷管理",
      "level": 1,
      "required": true,
      "must_answer": [
        "级别定义",
        "流转"
      ]
    },
    {
      "id": "coverage",
      "title": "需求覆盖矩阵",
      "level": 1,
      "required": true,
      "must_answer": [
        "REQ × TC，自动生成"
      ]
    }
  ],
  "numbering": {
    "section": "decimal",
    "appendix": "alpha",
    "max_depth": 3,
    "figure": "图 {chapter}-{seq}",
    "table": "表 {chapter}-{seq}",
    "entities": []
  },
  "include_allow": [
    "sections/*.md",
    "data/*.csv",
    "data/*.yaml"
  ],
  "features": {
    "code_blocks": false,
    "landscape": false,
    "data_blocks": true,
    "summary_block": true,
    "footnotes": true,
    "h1_new_page": null,
    "toc": true,
    "table_captions": true,
    "figure_numbers": true,
    "thead_repeat": true
  },
  "stages": [],
  "related": [
    {
      "type": "prd",
      "role": "source_prd",
      "for_gate": true,
      "required": true,
      "desc": "需求覆盖矩阵的需求来源"
    },
    {
      "type": "tech-spec",
      "role": "source_spec",
      "for_gate": false,
      "required": false,
      "desc": "测试策略参考的技术约束"
    },
    {
      "type": "test-cases",
      "role": "references",
      "for_gate": true,
      "required": false,
      "desc": "覆盖矩阵引用的用例清单"
    }
  ],
  "gates": {
    "D2": {
      "command": [
        "{python}",
        "{pack_dir}/scripts/check_coverage.py",
        "{run_dir}"
      ],
      "desc": "需求覆盖矩阵无未覆盖的 P0/P1 需求（读 run_dir/data/coverage.csv 的覆盖状态列）",
      "pass_exit_codes": [
        0
      ]
    }
  },
  "qa": {
    "rules_py": "qa_rules.py",
    "rules_md": "qa-rules.md",
    "engine_rules": {
      "include": "all",
      "exclude": [
        "L2"
      ]
    },
    "severity_overrides": {},
    "glossary": "glossary.json",
    "highlight_limits": {"total": 25, "per_page": 3, "max_length": 40},
    "key_figures": [
      {"id": "tested-version", "label": "被测版本", "pattern": "被测版本[：:\\s|]*(?P<value>v?\\d+(?:\\.\\d+)+(?:-[\\w.]+)?)", "normalize": "text", "severity": "提示"},
      {"id": "pass-rate", "label": "准出用例通过率", "pattern": "(?P<key>P[0-3])\\s*用例通过率\\s*(?:[≥≤<>=]\\s*)?(?P<value>\\d+(?:\\.\\d+)?)\\s*%", "normalize": "number", "severity": "提示"},
      {"id": "case-total", "label": "用例总数", "pattern": "(?P<value>\\d+)\\s*条用例", "normalize": "number", "severity": "提示"}
    ],
    "banned_terms": [
      {
        "term": "尽量",
        "regex": false,
        "severity": "建议",
        "message": "准入/准出标准出现空泛措辞，无法量化判定"
      },
      {
        "term": "争取",
        "regex": false,
        "severity": "建议",
        "message": "准入/准出标准出现空泛措辞，无法量化判定"
      },
      {
        "term": "差不多",
        "regex": false,
        "severity": "建议",
        "message": "准入/准出标准出现空泛措辞，无法量化判定"
      },
      {
        "term": "基本覆盖",
        "regex": false,
        "severity": "建议",
        "message": "准入/准出标准出现空泛措辞，无法量化判定"
      }
    ]
  },
  "hooks": {
    "pre_render": null,
    "pre_qa": null,
    "pre_publish": null,
    "post_publish": null
  },
  "cover": "technical",
  "filename": "{project}_测试计划_{title}_v{version}_{yyyymmdd}.pdf",
  "writing_contract": {
    "source": "无对应 lark-doc genre；本包自定",
    "snapshot": "writing-contract.md",
    "snapshot_date": "2026-09-15"
  },
  "templates": [
    "templates/doc.md",
    "skeleton.md",
    "templates/figures/coverage-heatmap.fig.json"
  ],
  "org_sections": [
    {"id": "qms", "path": "brand/org/sections/qms.md", "required": false}
  ],
  "samples": [
    "samples/membership-points-v2"
  ]
}
