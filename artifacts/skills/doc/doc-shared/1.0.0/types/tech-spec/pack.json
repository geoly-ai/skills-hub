{
  "schema_version": "1",
  "id": "tech-spec",
  "name": "技术方案设计文档（Tech Spec / Design RFC）",
  "version": "1.0.0",
  "status": "draft",
  "description": "技术方案设计文档（Tech Spec / Design RFC）类型包",
  "audience": "internal",
  "brand_profile": "internal",
  "run_root": "~/workspace/docs/{project}",
  "run_dir_pattern": "{type}-{short}-v{version}",
  "source_file": "doc.md",
  "outline_file": "outline.md",
  "meta_file": "doc.json",
  "inputs": [
    {
      "id": "input1",
      "desc": "关联 PRD 或问题描述（必须至少一项）",
      "required": true
    },
    {
      "id": "input2",
      "desc": "现状架构材料（如有）",
      "required": true
    },
    {
      "id": "input3",
      "desc": "关键约束（性能、兼容、安全）初稿",
      "required": true
    }
  ],
  "skeleton": [
    {
      "id": "background",
      "title": "背景与问题",
      "level": 1,
      "required": true,
      "must_answer": [
        "现状",
        "证据",
        "为什么现在做"
      ]
    },
    {
      "id": "goals",
      "title": "目标、非目标与约束",
      "level": 1,
      "required": true,
      "must_answer": [
        "不变量",
        "性能与兼容约束"
      ]
    },
    {
      "id": "current-arch",
      "title": "现状架构",
      "level": 1,
      "required": false,
      "when": "按需",
      "must_answer": [
        "现状架构图"
      ]
    },
    {
      "id": "design",
      "title": "方案设计",
      "level": 1,
      "required": true,
      "must_answer": [
        "架构图",
        "组件职责",
        "关键流程时序图",
        "数据模型 ER 图",
        "状态机"
      ]
    },
    {
      "id": "interface",
      "title": "接口设计",
      "level": 1,
      "required": false,
      "when": "按需",
      "must_answer": [
        "接口签名",
        "输入约束",
        "错误码",
        "幂等",
        "版本"
      ]
    },
    {
      "id": "alternatives",
      "title": "备选方案与取舍",
      "level": 1,
      "required": true,
      "must_answer": [
        "至少两个真实备选，同口径比较，否决理由"
      ]
    },
    {
      "id": "failure-safety",
      "title": "失败、安全与兼容",
      "level": 1,
      "required": true,
      "must_answer": [
        "失败模式",
        "降级",
        "权限",
        "数据安全",
        "向后兼容"
      ]
    },
    {
      "id": "rollout",
      "title": "迁移、上线与回滚",
      "level": 1,
      "required": true,
      "must_answer": [
        "步骤",
        "开关",
        "回滚判据"
      ]
    },
    {
      "id": "observability",
      "title": "可观测性",
      "level": 1,
      "required": true,
      "must_answer": [
        "指标",
        "日志",
        "告警"
      ]
    },
    {
      "id": "testing",
      "title": "测试与验收",
      "level": 1,
      "required": true,
      "must_answer": [
        "测试策略",
        "验收判据，链接测试计划"
      ]
    },
    {
      "id": "open-issues",
      "title": "未决问题",
      "level": 1,
      "required": true,
      "must_answer": [
        "owner 与截止"
      ]
    }
  ],
  "numbering": {
    "section": "decimal",
    "appendix": "alpha",
    "max_depth": 3,
    "figure": "图 {chapter}-{seq}",
    "table": "表 {chapter}-{seq}",
    "entities": [
      {
        "kind": "alternative",
        "label": "备选方案",
        "prefix": "ALT-",
        "pattern": "^ALT-\\d+$",
        "unique": true,
        "contiguous": true
      }
    ]
  },
  "include_allow": [
    "sections/*.md",
    "data/*.csv",
    "data/*.yaml"
  ],
  "features": {
    "code_blocks": true,
    "landscape": false,
    "data_blocks": true,
    "summary_block": true,
    "footnotes": true,
    "h1_new_page": null,
    "toc": true,
    "table_captions": true,
    "figure_numbers": true,
    "thead_repeat": true
  },
  "stages": [],
  "related": [
    {
      "type": "prd",
      "role": "source_prd",
      "for_gate": true,
      "required": true,
      "desc": "本方案对应的产品需求文档"
    }
  ],
  "gates": {
    "D2": null
  },
  "qa": {
    "rules_py": "qa_rules.py",
    "rules_md": "qa-rules.md",
    "engine_rules": {
      "include": "all",
      "exclude": [
        "L2"
      ]
    },
    "severity_overrides": {},
    "glossary": "glossary.json",
    "allowed_languages": ["json", "jsonc", "yaml", "yml", "toml", "ini", "xml", "sql", "http", "bash", "sh", "shell", "console", "text", "plaintext", "python", "java", "kotlin", "go", "rust", "c", "cpp", "csharp", "javascript", "js", "typescript", "ts", "protobuf", "proto", "graphql", "diff", "properties", "dockerfile", "nginx", "lua", "php", "ruby", "swift", "scala", "mermaid"],
    "highlight_limits": {"total": 25, "per_page": 3, "max_length": 40},
    "key_figures": [
      {"id": "dual-write-weeks", "label": "双写校验周期（周）", "pattern": "双写[^。；\\n]{0,12}?(?P<value>\\d+)\\s*周", "normalize": "number", "severity": "提示"},
      {"id": "gray-ratio", "label": "灰度比例", "pattern": "灰度\\s*(?P<value>\\d+(?:\\.\\d+)?)\\s*%", "normalize": "number", "severity": "提示"}
    ],
    "banned_terms": []
  },
  "hooks": {
    "pre_render": null,
    "pre_qa": null,
    "pre_publish": null,
    "post_publish": null
  },
  "cover": "technical",
  "filename": "{project}_TechSpec_{title}_v{version}_{yyyymmdd}.pdf",
  "writing_contract": {
    "source": "~/.claude/skills/lark-doc/references/genres/technical-doc.md（design_rfc 模式）",
    "snapshot": "writing-contract.md",
    "snapshot_date": "2026-09-15"
  },
  "templates": [
    "templates/doc.md",
    "skeleton.md",
    "templates/figures/current-arch.fig.json",
    "templates/figures/data-model.mmd",
    "templates/figures/sequence.mmd",
    "templates/figures/state-machine.mmd",
    "templates/figures/target-arch.fig.json"
  ],
  "org_sections": [
    {"id": "qms", "path": "brand/org/sections/qms.md", "required": false}
  ],
  "samples": [
    "samples/membership-points-v2"
  ]
}
