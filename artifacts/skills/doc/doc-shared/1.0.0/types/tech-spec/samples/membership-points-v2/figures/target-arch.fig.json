{
  "kind": "layered-arch",
  "title": "v2 积分系统目标架构",
  "layers": [
    { "id": "client", "label": "客户端层", "nodes": [ { "id": "app", "label": "会员 App / 商城前端" }, { "id": "admin", "label": "运营后台" } ] },
    { "id": "gateway", "label": "接入层", "nodes": [ { "id": "gw", "label": "API 网关" } ] },
    { "id": "service", "label": "服务层", "nodes": [
      { "id": "account-service", "label": "账户服务" },
      { "id": "redeem-service", "label": "兑换服务" },
      { "id": "rule-engine", "label": "规则引擎服务" }
    ] },
    { "id": "data", "label": "数据层", "nodes": [ { "id": "db", "label": "积分数据库（行锁）" }, { "id": "cache", "label": "规则本地缓存" } ] }
