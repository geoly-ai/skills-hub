    { "from": "gw", "to": "redeem-service", "label": "" },
    { "from": "account-service", "to": "rule-engine", "label": "同步查询规则" },
    { "from": "redeem-service", "to": "rule-engine", "label": "同步查询规则" },
    { "from": "rule-engine", "to": "cache", "label": "缓存兜底" },
    { "from": "account-service", "to": "db", "label": "" },
    { "from": "redeem-service", "to": "db", "label": "行锁原子扣减" }
  ]
