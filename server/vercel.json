{
  "rewrites": [
    {
      "source": "/v1/events",
      "destination": "/api/events"
    },
    {
      "source": "/v1/summary",
      "destination": "/api/summary"
    },
    {
      "source": "/v1/delete/challenge",
      "destination": "/api/delete-challenge"
    },
    {
      "source": "/v1/delete",
      "destination": "/api/delete"
    }
  ],
  "crons": [
    {
      "path": "/api/prune",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/events.js": {
      "maxDuration": 15
    },
    "api/summary.js": {
      "maxDuration": 30
    },
    "api/delete-challenge.js": {
      "maxDuration": 15
    },
    "api/delete.js": {
      "maxDuration": 15
    },
    "api/prune.js": {
      "maxDuration": 60
    }
  },
  "outputDirectory": "public"
}
