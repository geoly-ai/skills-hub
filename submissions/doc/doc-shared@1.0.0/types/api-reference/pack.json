{
  "schema_version": "1",
  "id": "api-reference",
  "name": "API 参考文档",
  "version": "1.0.0",
  "status": "draft",
  "description": "API 参考文档类型包",
  "audience": "internal",
  "brand_profile": "internal",
  "run_root": "~/workspace/docs/{project}",
  "run_dir_pattern": "{type}-{short}-v{version}",
  "source_file": "doc.md",
  "outline_file": "outline.md",
  "meta_file": "doc.json",
  "inputs": [
    {
      "id": "input1",
      "desc": "接口清单（至少覆盖关联 tech-spec「接口设计」节提到的核心接口）",
      "required": true
    },
    {
      "id": "input2",
      "desc": "鉴权机制说明",
      "required": true
    },
    {
      "id": "input3",
      "desc": "版本策略（当前版本、弃用计划如有）",
      "required": true
    }
  ],
  "skeleton": [
    {
      "id": "overview",
      "title": "接口总览",
      "level": 1,
      "required": true,
      "must_answer": [
        "服务边界",
        "base URL",
        "接口清单一览表"
      ]
    },
    {
      "id": "auth",
      "title": "鉴权",
      "level": 1,
      "required": true,
      "must_answer": [
        "鉴权方式",
        "凭证获取",
        "权限范围"
      ]
    },
    {
      "id": "conventions",
      "title": "通用约定",
      "level": 1,
      "required": true,
      "must_answer": [
        "分页",
        "幂等",
        "错误码表",
        "版本策略"
      ]
    },
    {
      "id": "endpoints",
      "title": "接口详情",
      "level": 1,
      "required": true,
      "must_answer": [
        "每个接口：签名",
        "权限",
        "输入约束",
        "行为/副作用",
        "输出",
        "错误",
        "示例"
      ]
    },
    {
      "id": "rate-limits",
      "title": "限流与重试",
      "level": 1,
      "required": false,
      "when": "按需",
      "must_answer": [
        "限流规则",
        "重试建议",
        "退避策略"
      ]
    },
    {
      "id": "compat",
      "title": "兼容与弃用",
      "level": 1,
      "required": false,
      "when": "按需",
      "must_answer": [
        "弃用接口清单",
        "迁移指引",
        "下线时间"
      ]
    },
    {
      "id": "changelog",
      "title": "变更记录",
      "level": 1,
      "required": true,
      "must_answer": [
        "版本",
        "日期",
        "变更内容",
        "是否破坏性"
      ]
    }
  ],
  "numbering": {
    "section": "decimal",
    "appendix": "alpha",
    "max_depth": 3,
    "figure": "图 {chapter}-{seq}",
    "table": "表 {chapter}-{seq}",
    "entities": [
      {
        "kind": "changelog",
        "label": "变更记录",
        "prefix": "CHG-",
        "pattern": "^CHG-\\d{3}$",
        "unique": true,
        "contiguous": true
      }
    ]
  },
  "include_allow": [
    "sections/*.md",
    "data/*.csv",
    "data/*.yaml"
  ],
  "features": {
    "code_blocks": true,
    "landscape": false,
    "data_blocks": true,
    "summary_block": true,
    "footnotes": true,
    "h1_new_page": null,
    "toc": true,
    "table_captions": true,
    "figure_numbers": true,
    "thead_repeat": true
  },
  "stages": [],
  "related": [
    {
      "type": "tech-spec",
      "role": "source_spec",
      "for_gate": false,
      "required": true,
      "desc": "接口设计依据的技术方案"
    }
  ],
  "gates": {
    "D2": null
  },
  "qa": {
    "rules_py": "qa_rules.py",
    "rules_md": "qa-rules.md",
    "engine_rules": {
      "include": "all",
      "exclude": [
        "L2"
      ]
    },
    "severity_overrides": {},
    "glossary": "glossary.json",
    "allowed_languages": ["json", "jsonc", "yaml", "yml", "xml", "http", "bash", "sh", "shell", "console", "curl", "text", "plaintext", "python", "java", "kotlin", "go", "javascript", "js", "typescript", "ts", "protobuf", "proto", "graphql", "csharp", "php", "ruby", "swift"],
    "highlight_limits": {"total": 25, "per_page": 3, "max_length": 40},
    "key_figures": [
      {"id": "token-ttl", "label": "Token 有效期（小时）", "pattern": "Token[^。\\n]{0,20}?有效期\\s*(?P<value>\\d+)\\s*(?:个)?小时", "normalize": "number", "severity": "提示"},
      {"id": "idem-window", "label": "幂等窗口（小时）", "pattern": "(?P<value>\\d+)\\s*小时内重复请求", "normalize": "number", "severity": "提示"},
      {"id": "rate-limit", "label": "接口限流（次/分钟）", "pattern": "(?P<key>/v\\d+/[\\w/{}-]+)\\s*每分钟最多\\s*(?P<value>\\d+)\\s*次", "normalize": "number", "severity": "提示"},
      {"id": "adjust-cap", "label": "单次权限上限", "pattern": "单次权限上限[^\\d\\n]{0,10}?(?P<value>\\d+)", "normalize": "number", "severity": "提示"}
    ],
    "banned_terms": []
  },
  "hooks": {
    "pre_render": null,
    "pre_qa": null,
    "pre_publish": null,
    "post_publish": null
  },
  "cover": "technical",
  "filename": "{project}_APIReference_{title}_v{version}_{yyyymmdd}.pdf",
  "writing_contract": {
    "source": "~/.claude/skills/lark-doc/references/genres/technical-doc.md（api_reference 模式）",
    "snapshot": "writing-contract.md",
    "snapshot_date": "2026-09-15"
  },
  "templates": [
    "templates/doc.md",
    "skeleton.md",
    "templates/figures/auth-flow.mmd"
  ],
  "samples": [
    "samples/membership-points-v2"
  ]
}
