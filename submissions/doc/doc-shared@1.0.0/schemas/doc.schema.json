{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-shared/doc.schema.json",
  "title": "doc.json 文档清单",
  "description": "写入者：doc-orchestrator。字段说明见 references/artifacts.md。类型包专属字段一律放 extra，不加顶层字段。",
  "type": "object",
  "required": ["type", "title", "project", "version", "status", "audience", "brand", "language", "owner", "lark_folder"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "类型包 id，如 prd、tech-spec、presales-site"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "project": {"type": "string", "minLength": 1, "description": "项目或客户英文短名，决定运行目录与飞书项目文件夹"},
    "client": {"type": "string", "description": "对外文档的客户名；页脚 {party} 优先取 client，否则取 project"},
    "doc_no": {"type": "string", "description": "文档编号，technical 封面文档控制表用"},
    "version": {"$ref": "#/$defs/version"},
    "date": {"$ref": "#/$defs/date"},
    "status": {"enum": ["draft", "review", "approved", "published"]},
    "audience": {"enum": ["internal", "external"]},
    "brand": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "品牌档案 id，对应 brand/profiles/<id>.json"},
    "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "owner": {"type": "string", "minLength": 1},
    "reviewers": {
      "type": "array",
      "description": "可写「姓名（角色）」字符串，或带评审结论的对象",
      "items": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/reviewer"}]}
    },
    "related_docs": {
      "type": "array",
      "description": "跨文档读取的唯一入口（scripts/related.py 解析）。字段与 role 词表见 references/artifacts.md §2.1",
      "items": {
        "type": "object",
        "required": ["type", "path", "role"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "对方的类型包 id"},
          "path": {"type": "string", "minLength": 1, "description": "对方运行目录或其 doc.json；相对路径按当前运行目录解析，也可写绝对路径（支持 ~）"},
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "本文档与对方的关系（必填，2026-09-15 契约第二轮），如 source_prd、covered_by、executes_plan、references"},
          "version": {"$ref": "#/$defs/version_loose"},
          "title": {"type": "string"},
          "url": {"type": "string"}
        }
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date", "author", "summary"],
        "additionalProperties": false,
        "properties": {
          "version": {"$ref": "#/$defs/version_loose"},
          "date": {"$ref": "#/$defs/date"},
          "author": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtitle": {"type": "string"},
        "meta": {"type": "array", "items": {"type": "string"}}
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "title": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"}
      }
    },
    "lark_folder": {
      "description": "decisions ⑫A：必填。开工时确认项目文件夹拿到 token；暂时拿不到时写 pending_reason 与拟定路径，D4 前必须补 token。",
      "oneOf": [
        {
          "type": "object",
          "required": ["token"],
          "additionalProperties": false,
          "properties": {
            "token": {"type": "string", "pattern": "^[A-Za-z0-9]{8,}$"},
            "path": {"type": "string"}
          }
        },
        {
          "type": "object",
          "required": ["pending_reason", "path"],
          "additionalProperties": false,
          "properties": {
            "pending_reason": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "lark_profile": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "extra": {"type": "object", "description": "类型包专属字段（pack.json 可在 doc_extra_schema 里约束）"}
  },
  "$defs": {
    "reviewer": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string"},
        "decision": {"enum": ["pending", "approved", "changes_requested", "rejected"]},
        "date": {"$ref": "#/$defs/date"}
      }
    },
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"},
    "version_loose": {"type": "string", "pattern": "^v?\\d+\\.\\d+(\\.\\d+)?$", "description": "修订记录与关联文档里允许写 v 前缀"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
